    "@opentelemetry/exporter-trace-otlp-http": "0.218.0",
    "@opentelemetry/instrumentation-winston": "0.61.0",
    "@opentelemetry/sdk-logs": "0.218.0",
    "@opentelemetry/sdk-node": "0.218.0",
    "@opentelemetry/winston-transport": "0.27.0",
    "cors": "2.8.6",
    "express": "5.2.1",
    "ioredis": "5.10.1",
