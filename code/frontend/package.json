    "winston": "3.19.0"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/supertest": "7.2.0",
    "jest": "30.4.2",
    "supertest": "7.2.2",
